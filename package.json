{
  "name": "branch-diff",
  "displayName": "Branch Diff",
  "description": "Show all changes on the current branch with VS Code's native gutter diff decorations.",
  "version": "0.2.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SlightOfHandio2/branch-diff.git"
  },
  "homepage": "https://github.com/SlightOfHandio2/branch-diff#readme",
  "bugs": {
    "url": "https://github.com/SlightOfHandio2/branch-diff/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "branch",
    "diff",
    "gutter"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "branchDiff.chooseBase",
        "title": "Branch Diff: Choose Comparison Branch"
      },
      {
        "command": "branchDiff.chooseScope",
        "title": "Branch Diff: Choose Diff Scope"
      },
      {
        "command": "branchDiff.useAutomaticBase",
        "title": "Branch Diff: Use Automatic Base"
      },
      {
        "command": "branchDiff.refresh",
        "title": "Branch Diff: Refresh"
      },
      {
        "command": "branchDiff.toggle",
        "title": "Branch Diff: Toggle Decorations"
      },
      {
        "command": "branchDiff.openChange",
        "title": "Open Branch Change"
      }
    ],
    "configuration": {
      "title": "Branch Diff",
      "properties": {
        "branchDiff.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show native editor gutter decorations for changes made since the branch split from its comparison branch."
        },
        "branchDiff.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Branch or Git ref to compare with. Leave empty to use the automatic base strategy."
        },
        "branchDiff.scope": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "committed",
            "staged",
            "all"
          ],
          "enumDescriptions": [
            "Only changes committed after the branch split.",
            "Committed changes plus changes in the Git index.",
            "Committed, staged, unstaged, and untracked changes."
          ],
          "default": "all",
          "description": "Which changes to include in Branch Diff."
        },
        "branchDiff.branchBases": {
          "type": "object",
          "scope": "window",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Map current branch names or wildcard patterns to comparison branches. Exact names take priority. Example: `{ \"feature/*\": \"develop\", \"release/*\": \"main\" }`. Used when `branchDiff.baseBranch` is empty."
        },
        "branchDiff.automaticBaseStrategy": {
          "type": "string",
          "enum": [
            "nearestAncestor",
            "defaultBranch"
          ],
          "enumDescriptions": [
            "Use the closest local branch whose tip is an ancestor of the current branch (ideal for stacked branches).",
            "Use the repository's remote or conventional default branch."
          ],
          "default": "nearestAncestor",
          "description": "How to choose the comparison branch when branchDiff.baseBranch is empty."
        },
        "branchDiff.colors": {
          "type": "object",
          "scope": "window",
          "default": {
            "added": "#C586C0",
            "modified": "#D7BA7D",
            "deleted": "#F48771"
          },
          "properties": {
            "added": {
              "type": "string",
              "format": "color-hex",
              "default": "#C586C0",
              "description": "Marker color for lines added on the branch."
            },
            "modified": {
              "type": "string",
              "format": "color-hex",
              "default": "#D7BA7D",
              "description": "Marker color for lines modified on the branch."
            },
            "deleted": {
              "type": "string",
              "format": "color-hex",
              "default": "#F48771",
              "description": "Marker color for lines deleted on the branch."
            }
          },
          "additionalProperties": false,
          "description": "Colors for Branch Diff's separate editor and overview-ruler markers."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "branchDiff.openChange",
          "when": "false"
        }
      ],
      "scm/title": [
        {
          "command": "branchDiff.refresh",
          "group": "navigation",
          "when": "scmProvider == branchDiff"
        },
        {
          "command": "branchDiff.chooseBase",
          "group": "navigation",
          "when": "scmProvider == branchDiff"
        },
        {
          "command": "branchDiff.chooseScope",
          "group": "navigation",
          "when": "scmProvider == branchDiff"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test dist/test/**/*.test.js",
    "check": "npm test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  }
}
