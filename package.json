{
  "name": "branch-diff",
  "displayName": "Diff Branch",
  "icon": "media/logo.png",
  "description": "Show all current-branch changes in a dedicated view with distinctive editor markers.",
  "version": "1.0.0",
  "publisher": "oddiss",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SlightOfHandio2/branch-diff.git"
  },
  "homepage": "https://github.com/SlightOfHandio2/branch-diff#readme",
  "bugs": {
    "url": "https://github.com/SlightOfHandio2/branch-diff/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "branch",
    "diff",
    "gutter"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "branchDiff.toggleLayout",
        "title": "Diff Branch: Toggle Flat / Folder Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "branchDiff.chooseBase",
        "title": "Diff Branch: Choose Comparison Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "branchDiff.chooseScope",
        "title": "Diff Branch: Choose Diff Scope",
        "icon": "$(filter)"
      },
      {
        "command": "branchDiff.useAutomaticBase",
        "title": "Diff Branch: Use Automatic Base"
      },
      {
        "command": "branchDiff.refresh",
        "title": "Diff Branch: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "branchDiff.toggle",
        "title": "Diff Branch: Toggle Decorations"
      },
      {
        "command": "branchDiff.openChange",
        "title": "Open Branch Change"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branchDiff",
          "title": "Diff Branch",
          "icon": "media/branch-diff.svg"
        }
      ]
    },
    "views": {
      "branchDiff": [
        {
          "id": "branchDiff.changes",
          "name": "Branch Changes",
          "icon": "media/branch-diff.svg",
          "contextualTitle": "Diff Branch"
        }
      ]
    },
    "colors": [
      {
        "id": "branchDiff.accent",
        "description": "Accent color used by the Diff Branch view.",
        "defaults": {
          "dark": "#C586C0",
          "light": "#8E3A86",
          "highContrast": "#FF8CF4",
          "highContrastLight": "#8E3A86"
        }
      },
      {
        "id": "branchDiff.added",
        "description": "Color for files added on the branch.",
        "defaults": {
          "dark": "#C586C0",
          "light": "#8E3A86",
          "highContrast": "#FF8CF4",
          "highContrastLight": "#8E3A86"
        }
      },
      {
        "id": "branchDiff.modified",
        "description": "Color for files modified on the branch.",
        "defaults": {
          "dark": "#D7BA7D",
          "light": "#8A6200",
          "highContrast": "#FFE28A",
          "highContrastLight": "#725000"
        }
      },
      {
        "id": "branchDiff.deleted",
        "description": "Color for files deleted on the branch.",
        "defaults": {
          "dark": "#F48771",
          "light": "#B52A20",
          "highContrast": "#FF9B89",
          "highContrastLight": "#A51F17"
        }
      }
    ],
    "configuration": {
      "title": "Diff Branch",
      "properties": {
        "branchDiff.viewLayout": {
          "type": "string",
          "enum": [
            "flat",
            "tree"
          ],
          "default": "flat",
          "scope": "window",
          "description": "Display changed files as a flat list or a folder tree."
        },
        "branchDiff.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show native editor gutter decorations for changes made since the branch split from its comparison branch."
        },
        "branchDiff.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Branch or Git ref to compare with. Leave empty to use the automatic base strategy."
        },
        "branchDiff.scope": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "committed",
            "staged",
            "all"
          ],
          "enumDescriptions": [
            "Only changes committed after the branch split.",
            "Committed changes plus changes in the Git index.",
            "Committed, staged, unstaged, and untracked changes."
          ],
          "default": "all",
          "description": "Which changes to include in Diff Branch."
        },
        "branchDiff.exclude": {
          "type": "array",
          "scope": "resource",
          "default": [],
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "markdownDescription": "Glob patterns for files Diff Branch should ignore. Supports `*`, `**`, and `?`. Examples: `**/*.snap`, `dist/**`, and `package-lock.json`."
        },
        "branchDiff.branchBases": {
          "type": "object",
          "scope": "window",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Map current branch names or wildcard patterns to comparison branches. Exact names take priority. Example: `{ \"feature/*\": \"develop\", \"release/*\": \"main\" }`. Used when `branchDiff.baseBranch` is empty."
        },
        "branchDiff.automaticBaseStrategy": {
          "type": "string",
          "enum": [
            "nearestAncestor",
            "defaultBranch"
          ],
          "enumDescriptions": [
            "Use the closest local branch whose tip is an ancestor of the current branch (ideal for stacked branches).",
            "Use the repository's remote or conventional default branch."
          ],
          "default": "nearestAncestor",
          "description": "How to choose the comparison branch when branchDiff.baseBranch is empty."
        },
        "branchDiff.colors": {
          "type": "object",
          "scope": "window",
          "default": {
            "added": "#C586C0",
            "modified": "#D7BA7D",
            "deleted": "#F48771"
          },
          "properties": {
            "added": {
              "type": "string",
              "format": "color-hex",
              "default": "#C586C0",
              "description": "Marker color for lines added on the branch."
            },
            "modified": {
              "type": "string",
              "format": "color-hex",
              "default": "#D7BA7D",
              "description": "Marker color for lines modified on the branch."
            },
            "deleted": {
              "type": "string",
              "format": "color-hex",
              "default": "#F48771",
              "description": "Marker color for lines deleted on the branch."
            }
          },
          "additionalProperties": false,
          "description": "Colors for Diff Branch's separate editor and overview-ruler markers."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "branchDiff.openChange",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "branchDiff.toggleLayout",
          "group": "navigation@3",
          "when": "view == branchDiff.changes"
        },
        {
          "command": "branchDiff.refresh",
          "group": "navigation@4",
          "when": "view == branchDiff.changes"
        },
        {
          "command": "branchDiff.chooseBase",
          "group": "navigation@1",
          "when": "view == branchDiff.changes"
        },
        {
          "command": "branchDiff.chooseScope",
          "group": "navigation@2",
          "when": "view == branchDiff.changes"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test dist/test/**/*.test.js",
    "check": "npm test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.7.2"
  }
}
